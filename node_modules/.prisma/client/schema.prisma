generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MÓDULO DE AUTENTICACIÓN Y USUARIOS
// ============================================

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  role      String    @default("OPERATOR")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

// ============================================
// MÓDULO DE ALMACÉN (Inventario)
// ============================================

model Warehouse {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  location  String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  materials WarehouseMaterial[]

  @@map("warehouses")
}

model Material {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  unit        String    @default("UNIDAD")
  minStock    Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  warehouses  WarehouseMaterial[]
  movements   StockMovement[]
  recipeItems RecipeItem[]

  @@map("materials")
}

model WarehouseMaterial {
  id          String   @id @default(uuid())
  warehouseId String
  materialId  String
  quantity    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])

  @@unique([warehouseId, materialId])
  @@map("warehouse_materials")
}

model StockMovement {
  id          String   @id @default(uuid())
  materialId  String
  warehouseId String
  type        String
  quantity    Float
  reason      String?
  createdAt   DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])

  @@map("stock_movements")
}

// ============================================
// MÓDULO DE PRODUCCIÓN
// ============================================

model Product {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  price       Float     @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  recipes Recipe[]
  plans   ProductionPlan[]

  @@map("products")
}

model Recipe {
  id        String   @id @default(uuid())
  productId String
  name      String
  version   String   @default("1.0")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id])
  items   RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id         String @id @default(uuid())
  recipeId   String
  materialId String
  quantity   Float
  unit       String @default("UNIDAD")

  recipe   Recipe   @relation(fields: [recipeId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@map("recipe_items")
}

model ProductionPlan {
  id        String    @id @default(uuid())
  productId String
  quantity  Int
  status    String    @default("DRAFT")
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product Product            @relation(fields: [productId], references: [id])
  results ProductionResult[]

  @@map("production_plans")
}

model ProductionResult {
  id        String   @id @default(uuid())
  planId    String
  quantity  Int
  defective Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())

  plan ProductionPlan @relation(fields: [planId], references: [id])

  @@map("production_results")
}
